[Unit]
Description=Multiplayer Game Server Visual Web Dashboard
After=network.target game-server.service
Wants=game-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/game-server
ExecStart=/usr/bin/python3 /opt/game-server/web/app.py 8080
Restart=always
RestartSec=2s

[Install]
WantedBy=multi-user.target
