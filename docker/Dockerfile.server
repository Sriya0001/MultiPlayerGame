# =============================================================================
# Stage 1: Build Environment
# =============================================================================
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libmysqlclient-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY CMakeLists.txt .
COPY server/ ./server/
COPY simulator/ ./simulator/
COPY database/ ./database/

RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target game_server --parallel $(nproc) \
    && strip build/server/game_server

# =============================================================================
# Stage 2: Minimal Runtime Environment
# =============================================================================
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libmysqlclient21 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Run as non-root unprivileged user
RUN useradd -u 10001 -m -s /bin/bash gameserver

WORKDIR /app

COPY --from=builder /workspace/build/server/game_server /app/game_server
COPY database/schema_mysql.sql /app/database/schema_mysql.sql

RUN chown -R gameserver:gameserver /app
USER gameserver

EXPOSE 7777 9100

HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
    CMD curl -f http://127.0.0.1:9100/health || exit 1

ENTRYPOINT ["/app/game_server"]
CMD ["--port", "7777", "--metrics-port", "9100", "--threads", "256", "--enable-redis", "--redis-host", "redis", "--redis-port", "6379", "--db-host", "mysql", "--db-port", "3306", "--db-user", "game_user", "--db-pass", "game_pass", "--db-name", "game_server"]
