# ── Build artifacts ───────────────────────────────────────────────────────────
build/
cmake-build-*/
*.o
*.a
*.so
*.dylib
*.exe

# ── CMake generated ───────────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
install_manifest.txt
CTestTestfile.cmake
_deps/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/

# ── Secrets / credentials — NEVER commit these ───────────────────────────────
.env
.env.*
*.pem
*.key
secrets/

# ── Test output / reports ─────────────────────────────────────────────────────
python/reports/*.csv
python/reports/*.json
python/reports/*.html
results/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
